/* 遮罩层 */
.sidebar-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0);
  z-index: 999;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.sidebar-mask.show {
  background-color: rgba(59, 90, 111, 0.8);
  opacity: 1;
  pointer-events: auto;
}

/* 侧边栏 */
.sidebar {
  position: fixed;
  top: 0;
  left: 0;
  width: 70%;
  max-width: 560rpx;
  height: 100vh;
  background-color: #FFFFFF;
  z-index: 1000;
  transform: translateX(-100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
}

.sidebar.show {
  transform: translateX(0);
}

/* Logo区域 */
.sidebar-logo {
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
}

.vinyl-record-small {
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
}

.record-outer-small {
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, #2C2C2C 0%, #1A1A1A 50%, #2C2C2C 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  position: relative;
}

.record-outer-small::before {
  content: '';
  position: absolute;
  width: 90%;
  height: 90%;
  border-radius: 50%;
  background: repeating-radial-gradient(
    circle at center,
    transparent 0,
    transparent 2rpx,
    rgba(255, 255, 255, 0.05) 2rpx,
    rgba(255, 255, 255, 0.05) 4rpx
  );
}

.record-inner-small {
  width: 40%;
  height: 40%;
  background-color: #C41E3A;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.record-center-small {
  width: 20%;
  height: 20%;
  background-color: #FFFFFF;
  border-radius: 50%;
}

.brand-name-small {
  font-size: 36rpx;
  font-weight: 600;
  color: #1D2129;
}

/* 导航区域 */
.nav-section {
  margin-bottom: 32rpx;
}

.nav-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.nav-item:last-child {
  border-bottom: none;
}

.nav-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 24rpx;
  color: #3B5A6F;
}

.nav-text {
  font-size: 30rpx;
  color: #1D2129;
  font-weight: 500;
}

/* 登录区域 */
.signin-section {
  background-color: #F8F9FA;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 32rpx 0;
}

.signin-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3B5A6F;
  display: block;
  margin-bottom: 16rpx;
}

.signin-desc {
  font-size: 26rpx;
  color: #86909C;
  line-height: 1.5;
  display: block;
  margin-bottom: 24rpx;
}

.social-icons {
  display: flex;
  gap: 24rpx;
}

.social-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #3B5A6F;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

/* 关闭按钮 */
.close-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #86909C;
}
