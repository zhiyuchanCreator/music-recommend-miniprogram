<!-- 骨架屏 -->
<skeleton type="home" loading="{{isLoading}}"></skeleton>

<!-- 离线模式弱提示 -->
<view class="offline-tip {{offlineMode ? 'show' : ''}}">
  <text class="offline-tip-text">当前网络不太稳，已为你加载本地推荐</text>
</view>

<view class="container page-enter" wx:if="{{!loadError}}">
  <!-- 侧边栏 -->
  <sidebar show="{{showSidebar}}" bind:close="onSidebarClose"></sidebar>

  <!-- 顶部搜索栏 - 始终显示 -->
  <view class="search-bar">
    <view class="menu-icon" bindtap="onMenuTap">
      <view class="menu-line"></view>
      <view class="menu-line"></view>
      <view class="menu-line"></view>
    </view>
    <view class="search-input-wrapper" bindtap="goToSearchPage">
      <view class="search-icon">
        <view class="search-circle"></view>
        <view class="search-handle"></view>
      </view>
      <text class="search-placeholder">Search...</text>
    </view>
  </view>

  <!-- 可隐藏区域：Logo、分类选择 -->
  <view class="header-section {{showHeader ? 'show' : 'hide'}}">
    <!-- Logo区域 -->
    <view class="logo-section">
      <view class="vinyl-record">
        <view class="record-outer">
          <view class="record-inner">
            <view class="record-center"></view>
          </view>
        </view>
      </view>
      <text class="brand-name">Shfl</text>
    </view>

    <!-- 分类选择区 -->
    <view class="category-section">
      <view class="section-title-wrapper">
        <view class="title-line"></view>
        <text class="section-title">choose a category</text>
        <view class="title-line"></view>
      </view>
      
      <view class="category-tags">
        <view 
          class="tag {{selectedCategory === item ? 'tag-active' : ''}}" 
          wx:for="{{categories}}" 
          wx:key="*this"
          data-category="{{item}}"
          bindtap="onCategoryTap"
        >{{item}}</view>
      </view>
    </view>
  </view>

  <!-- 随机推荐区 -->
  <view class="shuffle-section">
    <!-- 这个标题在隐藏区域外，始终显示 -->
    <view class="shuffle-title-wrapper {{!showHeader ? 'compact' : ''}}">
      <view class="title-line"></view>
      <text class="section-title italic">or trust in chance</text>
      <view class="title-line"></view>
    </view>
    
    <button class="shuffle-btn {{isShuffling ? 'shuffling' : ''}}" bindtap="onShuffleTap" disabled="{{isShuffling}}">
      <text wx:if="{{!isShuffling}}">Shfl</text>
      <view wx:if="{{isShuffling}}" class="shuffle-spinner"></view>
    </button>
  </view>

  <!-- 为你推荐区（基于用户 Memory 的个性化推荐） -->
  <view class="foryou-section" wx:if="{{forYouAlbums.length > 0}}">
    <view class="section-title-wrapper">
      <view class="title-line"></view>
      <text class="section-title">for you</text>
      <view class="title-line"></view>
    </view>
    <view class="foryou-hint">
      <text>基于你的收藏与浏览历史生成</text>
    </view>
    <view class="foryou-list">
      <view class="foryou-item list-item-{{index % 10}}" wx:for="{{forYouAlbums}}" wx:key="id" bindtap="onAlbumTap" data-id="{{item.id}}">
        <image class="foryou-image" src="{{item.image}}" mode="aspectFill" lazy-load="true"/>
        <view class="foryou-info">
          <text class="foryou-title">{{item.title}}</text>
          <text class="foryou-artist">{{item.artist}}</text>
          <text class="foryou-reason">{{item.reason}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 最近推荐区 -->
  <view class="recent-section">
    <view class="section-title-wrapper">
      <view class="title-line"></view>
      <text class="section-title">recent guides</text>
      <view class="title-line"></view>
    </view>
    
    <!-- 有数据时显示列表 -->
    <view class="recent-list" wx:if="{{recentGuides.length > 0}}">
      <view class="recent-item list-item-{{index % 10}}" wx:for="{{recentGuides}}" wx:key="id" bindtap="onAlbumTap" data-id="{{item.id}}">
        <image
          class="recent-image"
          src="{{item.image}}"
          mode="aspectFill"
          lazy-load="true"
          binderror="onImageError"
          data-index="{{index}}"
        />
        <view class="recent-info">
          <text class="recent-title">{{item.title}}</text>
          <text class="recent-artist">{{item.artist}}</text>
        </view>
      </view>
    </view>

    <!-- 无数据时显示空状态 -->
    <empty-state
      wx:if="{{!isLoading && recentGuides.length === 0 && !offlineMode}}"
      type="empty"
      bind:retry="onRefresh"
    />
  </view>
</view>

<!-- 加载失败时显示错误状态 -->
<view class="error-fallback" wx:if="{{loadError}}">
  <empty-state
    type="{{errorType}}"
    bind:retry="onRefresh"
  />
</view>
