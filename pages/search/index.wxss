.container {
  min-height: 100vh;
  background-color: #F8F9FA;
}

/* 搜索栏 */
.search-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #E5E6EB;
}

.back-btn {
  font-size: 36rpx;
  color: #1D2129;
  margin-right: 24rpx;
  padding: 8rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #F2F3F5;
  border-radius: 36rpx;
  padding: 16rpx 24rpx;
  position: relative;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1D2129;
  margin-right: 40rpx;
}

.clear-icon {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  background-color: #C9CDD4;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
}

.placeholder {
  color: #86909C;
}

.search-btn {
  font-size: 28rpx;
  color: #4A9B8C;
  margin-left: 24rpx;
  font-weight: 500;
}

/* 搜索历史 */
.search-history {
  padding: 32rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.history-title {
  font-size: 30rpx;
  color: #1D2129;
  font-weight: 500;
}

.delete-icon {
  width: 44rpx;
  height: 44rpx;
}

.delete-icon image {
  width: 100%;
  height: 100%;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.history-item {
  background-color: #FFFFFF;
  border: 1rpx solid #E5E6EB;
  padding: 16rpx 28rpx;
  border-radius: 32rpx;
}

.history-text {
  font-size: 28rpx;
  color: #4E5969;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx;
  color: #86909C;
  font-size: 28rpx;
}
