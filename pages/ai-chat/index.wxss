.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F7F8FA;
}

/* 消息列表 */
.chat-list {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-row.user {
  justify-content: flex-end;
}

.msg-row.assistant {
  justify-content: flex-start;
}

.bubble {
  max-width: 85%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.bubble.user {
  background-color: #1D2129;
  color: #FFFFFF;
  border-bottom-right-radius: 6rpx;
}

.bubble.assistant {
  background-color: #FFFFFF;
  color: #1D2129;
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.bubble.loading {
  color: #86909C;
}

/* 推荐专辑卡片 */
.album-cards {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.album-card {
  display: flex;
  align-items: center;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 12rpx;
}

.album-cover {
  width: 88rpx;
  height: 88rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.album-meta {
  flex: 1;
  overflow: hidden;
}

.album-title {
  display: block;
  font-size: 26rpx;
  color: #1D2129;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.album-artist {
  display: block;
  font-size: 22rpx;
  color: #86909C;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-bottom {
  height: 24rpx;
}

/* 示例问题 */
.samples {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 24rpx 16rpx;
}

.sample-chip {
  font-size: 24rpx;
  color: #4E5969;
  background: #FFFFFF;
  border: 1rpx solid #E5E6EB;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
}

/* 输入区 */
.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-top: 1rpx solid #E5E6EB;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #F2F3F5;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.send-btn {
  margin: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  background-color: #1D2129;
  color: #FFFFFF;
  border-radius: 36rpx;
}

.send-btn.disabled {
  opacity: 0.5;
}
