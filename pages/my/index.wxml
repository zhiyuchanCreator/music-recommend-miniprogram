<view class="container">
  <!-- 骨架屏 -->
  <skeleton wx:if="{{loading}}" type="my"></skeleton>

  <block wx:else>
    <!-- 用户信息卡片 -->
    <view class="user-card">
      <view class="user-avatar">
        <text class="avatar-icon">♪</text>
      </view>
      <text class="user-name">音乐爱好者</text>
      <text class="user-bio">发现好音乐，分享好时光</text>
    </view>

    <!-- 专辑墙 -->
    <view class="wall-section" wx:if="{{wallAlbums.length > 0}}">
      <view class="wall-header">
        <text class="wall-title">专辑墙</text>
        <view class="wall-actions">
          <view class="wall-change-btn" bindtap="onChangeWallMode">
            <text>切换</text>
            <text class="wall-change-target">{{wallMode === 'favorites' || (wallMode === 'auto' && favorites.length >= 3) ? '历史' : '收藏'}}</text>
          </view>
          <view class="wall-expand-btn" bindtap="onToggleWallExpand">
            <text>{{isWallExpanded ? '收起' : '展开'}}</text>
          </view>
        </view>
      </view>

      <!-- 横向滚动模式 -->
      <view
        wx:if="{{!isWallExpanded}}"
        class="wall-scroll"
      >
        <view
          class="wall-track {{wallAlbums.length > 1 ? 'wall-track-animated' : ''}}"
          style="animation-duration: {{wallTrackDuration}}s;"
        >
          <view
            class="wall-item"
            hover-class="wall-item-hover"
            hover-stay-time="600"
            wx:for="{{wallAlbumsLoop}}"
            wx:key="index"
            data-id="{{item.id}}"
            bindtap="onWallItemTap"
            bindlongpress="onWallItemLongPress"
          >
            <image class="wall-cover" src="{{item.coverUrl}}" mode="aspectFill"/>
            <view class="wall-pin-badge" wx:if="{{item.isPinned}}">
              <text>📌</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 展开网格模式：一行三张 -->
      <view wx:else class="wall-grid">
        <view
          class="wall-grid-item"
          hover-class="wall-item-hover"
          hover-stay-time="600"
          wx:for="{{wallAlbums}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onWallItemTap"
          bindlongpress="onWallItemLongPress"
        >
          <image class="wall-grid-cover" src="{{item.coverUrl}}" mode="aspectFill"/>
          <view class="wall-pin-badge" wx:if="{{item.isPinned}}">
            <text>📌</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 统计卡片 -->
    <view class="stats-card">
      <view class="stat-item" bindtap="switchToTab" data-tab="favorites">
        <text class="stat-num">{{favorites.length}}</text>
        <text class="stat-label">收藏</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="switchToTab" data-tab="history">
        <text class="stat-num">{{history.length}}</text>
        <text class="stat-label">历史</text>
      </view>
    </view>

    <!-- 标签切换 -->
    <view class="tab-section">
      <view class="tab-bar">
        <view class="tab-item {{activeTab === 'favorites' ? 'active' : ''}}" 
              bindtap="onTabChange" 
              data-tab="favorites">
          <text class="tab-text">我的收藏</text>
          <text wx:if="{{favorites.length > 0}}" class="tab-badge">{{favorites.length}}</text>
        </view>
        <view class="tab-item {{activeTab === 'history' ? 'active' : ''}}" 
              bindtap="onTabChange" 
              data-tab="history">
          <text class="tab-text">浏览历史</text>
          <text wx:if="{{history.length > 0}}" class="tab-badge">{{history.length}}</text>
        </view>
      </view>

      <!-- 收藏列表 -->
      <view wx:if="{{activeTab === 'favorites'}}" class="content-area">
        <!-- 空状态 -->
        <view wx:if="{{favoriteAlbums.length === 0}}" class="empty-state">
          <view class="empty-icon-wrap">
            <text class="empty-icon">☆</text>
          </view>
          <text class="empty-title">暂无收藏专辑</text>
          <text class="empty-desc">在专辑详情页点击收藏按钮添加</text>
          <view class="empty-action" bindtap="goToHome">
            <text>去发现音乐</text>
          </view>
        </view>

        <!-- 列表 -->
        <view wx:else class="list-container">
          <view class="list-header">
            <text class="list-title">共 {{favorites.length}} 张专辑</text>
            <view class="clear-btn" bindtap="onClearFavorites">
              <text class="clear-icon">🗑</text>
              <text>清空</text>
            </view>
          </view>

          <view class="album-grid">
            <view class="album-card" 
                  wx:for="{{favoriteAlbums}}" 
                  wx:key="id"
                  bindtap="onAlbumTap"
                  data-id="{{item.id}}"
                  style="animation-delay: {{index * 50}}ms">
              <view class="card-image-wrap">
                <image class="card-image" src="{{item.coverUrl}}" mode="aspectFill" lazy-load/>
                <view class="card-overlay">
                  <view class="play-icon">▶</view>
                </view>
              </view>
              <view class="card-content">
                <text class="card-title">{{item.title}}</text>
                <text class="card-artist">{{item.artist}}</text>
              </view>
              <view class="remove-btn" 
                    catchtap="onRemoveFavorite"
                    data-id="{{item.id}}">
                <text>✕</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 历史列表 -->
      <view wx:if="{{activeTab === 'history'}}" class="content-area">
        <!-- 空状态 -->
        <view wx:if="{{historyAlbums.length === 0}}" class="empty-state">
          <view class="empty-icon-wrap">
            <text class="empty-icon">🕐</text>
          </view>
          <text class="empty-title">暂无浏览记录</text>
          <text class="empty-desc">浏览过的专辑会显示在这里</text>
          <view class="empty-action" bindtap="goToHome">
            <text>去发现音乐</text>
          </view>
        </view>

        <!-- 列表 -->
        <view wx:else class="list-container">
          <view class="list-header">
            <text class="list-title">共 {{history.length}} 条记录</text>
            <view class="clear-btn" bindtap="onClearHistory">
              <text class="clear-icon">🗑</text>
              <text>清空</text>
            </view>
          </view>

          <view class="history-list">
            <view class="history-item" 
                  wx:for="{{historyAlbums}}" 
                  wx:key="_id"
                  bindtap="onAlbumTap"
                  data-id="{{item._id}}"
                  style="animation-delay: {{index * 30}}ms">
              <view class="history-time">
                <text class="time-date">{{item.viewTimeStr}}</text>
              </view>
              <view class="history-content">
                <image class="history-image" src="{{item.coverUrl}}" mode="aspectFill" lazy-load/>
                <view class="history-info">
                  <text class="history-title">{{item.title}}</text>
                  <text class="history-artist">{{item.artist}}</text>
                </view>
                <view class="history-arrow">›</view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
