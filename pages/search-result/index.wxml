<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="onBackTap">
      <text class="back-icon">←</text>
    </view>
    <text class="title">"{{keyword}}" 的搜索结果</text>
  </view>
  
  <view wx:if="{{loading}}" class="loading">搜索中...</view>
  
  <view wx:elif="{{results.length > 0}}" class="result-list">
    <view class="result-item" wx:for="{{results}}" wx:key="id" bindtap="onAlbumTap" data-id="{{item.id}}">
      <image class="result-image" src="{{item.image}}" mode="aspectFill"/>
      <view class="result-info">
        <text class="result-title">{{item.title}}</text>
        <text class="result-artist">{{item.artist}}</text>
      </view>
    </view>
  </view>
  
  <view wx:else class="empty">
    <text>没有找到相关专辑</text>
  </view>
</view>
