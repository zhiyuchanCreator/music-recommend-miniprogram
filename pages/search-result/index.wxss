.container {
  min-height: 100vh;
  background-color: #F8F9FA;
}

.header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #E5E6EB;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #F2F3F5;
  margin-right: 24rpx;
}

.back-icon {
  font-size: 32rpx;
  color: #86909C;
  font-weight: bold;
}

.title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1D2129;
}

.loading, .empty {
  text-align: center;
  padding: 100rpx;
  color: #86909C;
}

.result-list {
  padding: 24rpx;
}

.result-item {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.result-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
}

.result-info {
  flex: 1;
}

.result-title {
  font-size: 30rpx;
  color: #1D2129;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.result-artist {
  font-size: 26rpx;
  color: #86909C;
}

/* ========== 加载失败临时提示 ========== */
.retry-tip {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #F8F9FA;
  padding: 80rpx 60rpx;
  text-align: center;
  z-index: 50;
}

.retry-tip-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.85;
}

.retry-tip-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 16rpx;
}

.retry-tip-desc {
  font-size: 28rpx;
  color: #86909C;
  line-height: 1.5;
}
